# The uwubot supervisor normally sets these before launching the sidecar.
XMTP_ENV=dev
UWUBOT_DATA_DIR=.

# Optional: provide a stable identity yourself. If omitted on first launch,
# cryptographically random keys are created under UWUBOT_DATA_DIR/state.
# XMTP_WALLET_KEY=0x...
# XMTP_DB_ENCRYPTION_KEY=0x...

# Optional overrides:
# XMTP_DB_DIRECTORY=./state/xmtp/dev
# UWUBOT_REPLY_TIMEOUT_MS=300000
