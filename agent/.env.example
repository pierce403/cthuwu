# The uwubot supervisor normally sets these before launching the sidecar.
XMTP_ENV=production
UWUBOT_DATA_DIR=.

# The persistent wallet and database keys are created under
# UWUBOT_DATA_DIR/state/xmtp-identity.json and are never accepted here.

# Optional overrides:
# XMTP_DB_DIRECTORY=./state/xmtp/dev
# UWUBOT_REPLY_TIMEOUT_MS=300000
