# The uwubot supervisor normally sets these before launching the sidecar.
XMTP_ENV=production
UWUBOT_DATA_DIR=.

# The persistent wallet and database keys are created under
# UWUBOT_DATA_DIR/state/xmtp-identity.json and are never accepted here.

# Optional overrides:
# XMTP_DB_DIRECTORY=./state/xmtp/dev
# UWUBOT_REPLY_TIMEOUT_MS=300000

# Three-channel control plane (production only). Bootstrap the single Global group explicitly with
# `uwubot chat global create`, then persist the returned ID here. Normal enrollment never creates it.
# CTHUWU_GLOBAL_GROUP_ID=<64-lowercase-hex-conversation-id>
# CTHUWU_GLOBAL_ADMIN_INBOX_IDS=<64-hex-inbox>,<64-hex-inbox>
# CTHUWU_ASSIGNMENT_REVALIDATE_SECONDS=900

# Verified canonical Base Branding deployment. This is also the built-in default; override only for
# explicit development or migration testing. Read failures freeze Branding assignment.
CTHUWU_BRANDING_CONTRACT=0xD8c36F13D79a505C7FBDc5F6467eA3cd75E896Da

# Optional credential-free HTTPS or loopback HTTP Base endpoint.
# CTHUWU_RPC_ENDPOINT=https://mainnet.base.org
