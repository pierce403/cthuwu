# The browser always uses XMTP production; there are no XMTP build-time overrides.

# Public static leaderboard configuration. A Graph API key compiled into browser JavaScript is
# public: restrict it to cthuwu.app, the exact Agent0 Base subgraph, and a conservative spending limit;
# monitor its usage and rotate it through the static deployment when needed. The Pages workflow
# validates these values and refuses to deploy when the endpoint or API-key placeholder is missing.
# Optional override. Default is the official Agent0 Base ERC-8004 subgraph.
# VITE_CTHUWU_GRAPHQL_ENDPOINT=https://gateway.thegraph.com/api/{api-key}/subgraphs/id/43s9hQRurMGjuYnC1r2ZwS6xSQktbFyXMPMqGKUFJojb
VITE_CTHUWU_GRAPH_API_KEY=REPLACE_ME
VITE_CTHUWU_BASE_RPC_ENDPOINT=https://mainnet.base.org/
# Gateways are retained for bounded public profile links. V1 avatars always use the local mascot;
# the browser never downloads image bytes named by an untrusted registration document.
VITE_CTHUWU_IPFS_GATEWAY=https://cloudflare-ipfs.com/ipfs/
VITE_CTHUWU_ARWEAVE_GATEWAY=https://arweave.net/
VITE_CTHUWU_LEADERBOARD_FRESH_MS=900000
